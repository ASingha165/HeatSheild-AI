# HeatShield AI - Environment Configuration

# Server Settings
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# Strands Decider 2B Settings
# Official checkpoint from Hugging Face or local path
DECIDER_MODEL_CHECKPOINT=StrandsAgents/strands-decider-2B-hobson-v21
DECIDER_DEVICE=cpu
DECIDER_USE_PREFIX_CACHE=true
DECIDER_CONFIDENCE_THRESHOLD=0.60

# Optional: If running Decider on a dedicated server (e.g., via `strands-decider serve`)
# Leave blank to use in-process engine if model weights are loaded locally
DECIDER_REMOTE_URL=

# Amazon Bedrock Settings
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_TEMPERATURE=0.2

# AWS Authentication (Use IAM roles where possible; do NOT commit secrets)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Development and Transparent Mode
# When Decider model weights or Bedrock credentials are not present,
# system reports integration as UNCONFIGURED and operates in transparent dev mode.
ENABLE_DEV_MODE=true
