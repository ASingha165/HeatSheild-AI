# HeatShield AI - Environment Configuration Example
# Copy this file to .env for local configuration:
#   copy .env.example .env (Windows) or cp .env.example .env (Linux/macOS)
# WARNING: NEVER commit .env or AWS credentials to version control.

# Server Settings
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# Strands Decider 2B Settings
# Official checkpoint from Hugging Face or local path
DECIDER_MODEL_CHECKPOINT=StrandsAgents/strands-decider-2B-hobson-v21
DECIDER_DEVICE=cpu
DECIDER_USE_PREFIX_CACHE=true
DECIDER_CONFIDENCE_THRESHOLD=0.60

# Optional: If running Decider on a dedicated server (e.g., via `strands-decider serve`)
# Leave blank to use in-process engine if model weights are loaded locally
DECIDER_REMOTE_URL=

# Amazon Bedrock Settings
# Region: us-east-1 (or your workshop region)
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1

# Model ID: Amazon Nova 2 Lite
# Global inference profile (recommended for workshop):
BEDROCK_MODEL_ID=global.amazon.nova-2-lite-v1:0
# Alternative US regional inference profile:
# BEDROCK_MODEL_ID=us.amazon.nova-2-lite-v1:0
# Direct foundation model ID:
# BEDROCK_MODEL_ID=amazon.nova-lite-v1:0

BEDROCK_TEMPERATURE=0.2
BEDROCK_MAX_TOKENS=1024
BEDROCK_TIMEOUT_SECONDS=15

# AWS Authentication:
# Standard boto3 credential provider chain is used.
# In production on EC2/ECS, rely on IAM instance profiles / execution roles.
# For temporary AWS Workshop Studio testing in PowerShell, set environment variables in your active shell:
#   $env:AWS_DEFAULT_REGION="us-east-1"
#   $env:AWS_REGION="us-east-1"
#   $env:BEDROCK_MODEL_ID="global.amazon.nova-2-lite-v1:0"
#   $env:AWS_ACCESS_KEY_ID="<your-access-key-id>"
#   $env:AWS_SECRET_ACCESS_KEY="<your-secret-access-key>"
#   $env:AWS_SESSION_TOKEN="<your-session-token>"
#
# DO NOT put long-lived credentials or workshop credentials in this file.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Development and Transparent Fallback Mode
# When Decider model weights or Bedrock credentials are not present,
# system reports integration as UNCONFIGURED and operates in transparent dev fallback mode.
ENABLE_DEV_MODE=true
