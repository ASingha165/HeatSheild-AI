{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/health.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/locations.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/config/status.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/reports/analyze.py",
      "use": "@vercel/python"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "public"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/health",
      "dest": "api/health.py"
    },
    {
      "src": "/api/locations",
      "dest": "api/locations.py"
    },
    {
      "src": "/api/config/status",
      "dest": "api/config/status.py"
    },
    {
      "src": "/api/reports/analyze",
      "dest": "api/reports/analyze.py"
    },
    {
      "src": "/api/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/api",
      "dest": "api/index.py"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/favicon.svg",
      "dest": "/favicon.svg"
    },
    {
      "src": "/icons.svg",
      "dest": "/icons.svg"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
